+def test_two_ranks_construct_and_only_they_get_the_lone_graph_slot_by_default(monkeypatch):
+    from tensorfold.families.qwen4_exp.cuda import multi
+
+    class FakeState:
+        def __init__(self, w, capacity, rows, kv_dtype, limit):
+            self.capacity, self.limit = capacity, limit
+
+        def cache_bytes(self, rows=None):
+            return 0
+
+    monkeypatch.setattr(multi, "State", FakeState)
+    monkeypatch.setattr(multi, "Buffers", lambda *a, **k: SimpleNamespace())
+    monkeypatch.setattr(multi.gdn_multi, "Scratch", lambda *a: SimpleNamespace(parity=0))
+    monkeypatch.setattr(multi, "converges", lambda w: True)
+    monkeypatch.setattr(multi, "solo", lambda w, st, *a: SimpleNamespace(st=st))
+    def make(comm, **options):
+        w = SimpleNamespace(comm=comm, cfg=SimpleNamespace(eos=[1]), mtp=object(), draft_ids=None)
+        return MultiDecoder(w, slots=2, capacity=1024, depth=3, **options)
+    two = make(SimpleNamespace())                        # 0.6.2 raised "concurrent Flash Next runs on one GPU"
+    assert two.solo is not None and two.solo.st is two.slots[0] and two.link is None
+    assert make(None).solo is None                       # one GPU: 0.6.2's eager rounds
+    assert make(None, lone_graphs=True).solo is not None
+    assert make(SimpleNamespace(), graphs=False).solo is None
+
