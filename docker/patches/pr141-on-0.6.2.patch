+def test_a_state_copy_fills_a_larger_destinations_leading_rows():
+    import torch
+
+    from tensorfold.families.qwen4_exp.cuda import kvcache
+    from tensorfold.families.qwen4_exp.cuda.state import State
+
+    def state(rows, fill, pos):
+        st = object.__new__(State)
+        st.kc = [kvcache.KVCache(rows, 1, 32, "cpu", "int8")]
+        st.ikc, st.conv = [torch.full((rows, 4), fill)], torch.full((2, 3), fill)
+        st.capacity, st.limit, st.pos, st.cur = rows, 1024, pos, [pos % 2]
+        st.kc[0].k.fill_(fill)
+        st.kc[0].ks.fill_(fill)
+        return st
+
+    slot, stream = state(16, 0, 0), state(8, 3, 5)
+    slot.copy_from(stream)                               # the graph slot keeps its 16 rows (and their addresses)
+    assert slot.capacity == 16 and slot.kc[0].capacity == 16 and slot.pos == 5 and slot.cur == [1]
+    assert (slot.conv == 3).all() and (slot.ikc[0][:8] == 3).all() and (slot.ikc[0][8:] == 0).all()
+    assert (slot.kc[0].k[:8] == 3).all() and (slot.kc[0].ks[:8] == 3).all() and (slot.kc[0].k[8:] == 0).all()
+    with pytest.raises(ValueError, match="cache rows"):
+        stream.copy_from(state(16, 1, 0))
