+def test_a_smaller_lone_stream_moves_into_the_larger_graph_slot_without_resizing_it(monkeypatch):
+    from tensorfold.families.qwen4_exp.cuda.multi_tp import shape
+
+    leader, follower = _graph_slot_pair(monkeypatch)
+    for d in (leader, follower):
+        d.slots[0].capacity = 1024                       # idle at its high-water rows, counted by the gate
+        d.memory_gate.take(2 * (1024 - 256) * 100)
+        d.slots[1].pos = d.slots[1].mtp_len = 200
+        d.streams, d.free = {1: Stream([8] * 200, 8, sid=1, st=d.slots[1], out=[9], drafts=[4])}, d.slots[::2]
+    graphs = [d.solo.graphs for d in (leader, follower)]
+    plan = _round_both(leader, follower)
+    assert plan["solo"] == 1 and plan["actions"] == [["reset", 0], ["copy", 0, 1], ["reset", 1]]
+    for d, g in zip((leader, follower), graphs):
+        assert d.solo.graphs is g and d.streams[1].st is d.slots[0] and d.slots[0].capacity == 1024
+        assert d.slots[0].operations == [("reset",), ("copy", d.slots[1])] and d.slots[1].operations == [("reset",)]
+        assert d.memory_gate.held == 2 * (1024 - 256) * 100 and d.free == [d.slots[2], d.slots[1]]
+    assert shape(leader) == shape(follower)
+
