+def test_a_cache_change_failing_on_one_rank_fails_both_before_the_models_collectives(monkeypatch, mine, theirs, error):
+    from tensorfold.families.qwen4_exp.cuda import multi_tp
+
+    d = decoder()
+    d.w.comm = SimpleNamespace(all_gather=None)
+    plan = admission(d, Stream([7] * 310, 8))
+    assert plan["actions"]
+    if not mine:
+        def fail(rows):
+            raise RuntimeError("partial allocation")
+        d.slots[2].resize = fail
+    sent = []
+    def gather(torch, all_gather, values):
+        sent.append(values)
+        return [values, [_digest([theirs])]]
+    monkeypatch.setattr(multi_tp, "gather_ints", gather)
+    with pytest.raises(Exception, match=error):
+        d._apply(plan)
+    assert sent == [[_digest([mine])]]                   # one all-gather on either rank, failed or not
