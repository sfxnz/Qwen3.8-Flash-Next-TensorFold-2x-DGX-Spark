+def test_a_short_stream_in_the_idle_graph_slot_gives_back_rows_another_admission_needs(monkeypatch):
+    from tensorfold.families.qwen4_exp.cuda.multi_tp import shape
+
+    leader, follower = _graph_slot_pair(monkeypatch)
+    idle = 2 * (1024 - 256) * 100
+    for d in (leader, follower):
+        d.slots[0].capacity = 1024                       # idle at its high-water rows after a long lone reply
+        d.memory_gate = MemoryGate(300000, 0)
+        d.memory_gate.take(idle)
+    graphs = [d.solo.graphs for d in (leader, follower)]
+    plans = []
+    for prompt in ([7] * 10, [8] * 300):                 # two requests arrive together
+        plan = admission(leader, Stream(prompt, 8))
+        for d in (leader, follower):
+            assert ready(d, plan)
+            apply(d, plan)
+            s = Stream(prompt, 8, sid=d.next_id, st=d.slots[plan["slot"]])
+            d.filling.append(s)
+            d.fills[s.sid] = [SimpleNamespace(stops=[]), True, 0, None]
+            d.next_id += 1
+        plans.append(plan)
+    assert [(p["slot"], p["error"], p["actions"]) for p in plans] == [
+        (0, None, []), (2, None, [["resize", 0, 256], ["resize", 2, 1024]])]
+    for d, g in zip((leader, follower), graphs):
+        assert d.slots[0].capacity == 256 and d.slots[2].capacity == 1024
+        assert d.solo.graphs is not g and d.memory_gate.held == idle
+    assert shape(leader) == shape(follower)
+
