+def test_memory_pressure_takes_back_an_idle_graph_slots_rows_on_both_ranks(monkeypatch):
+    from tensorfold.families.qwen4_exp.cuda.multi_tp import shape
+
+    leader, follower = _graph_slot_pair(monkeypatch)
+    idle = 2 * (1024 - 256) * 100                        # the idle graph slot's rows above its first
+    need = 2 * (1024 - 256) * 100 + 1024 * 100           # a stream's growth, one layer held twice meanwhile
+    for d in (leader, follower):
+        d.slots[0].capacity = 1024
+        d.memory_gate = MemoryGate(idle + need - 1, 0)   # the growth fits only once the idle slot gives its rows back
+        d.memory_gate.take(idle)
+        d.streams = {i: Stream([7], 40, sid=i, st=d.slots[i], out=[3], drafts=[4]) for i in (1, 2)}
+        d.slots[1].pos = d.slots[1].mtp_len = 290
+        d.free = [d.slots[0]]
+    graphs = [d.solo.graphs for d in (leader, follower)]
+    plan = _round_both(leader, follower)
+    assert plan["actions"] == [["reset", 0], ["resize", 0, 256], ["resize", 1, 1024]]
+    assert plan["ended"] == [] and plan["solo"] is None and plan["waits"] == 0
+    for d, g in zip((leader, follower), graphs):
+        assert d.slots[0].capacity == 256 and d.slots[1].capacity == 1024
+        assert d.solo.graphs is not g                    # resized: its graphs' pointers are gone with the rows
+        assert d.memory_gate.held == 2 * (1024 - 256) * 100       # exactly the grown stream's rows
+    assert shape(leader) == shape(follower)
+
