+# The port onto 0.6.2: its prompt-pass fixes on one GPU, and the per-rank inputs they read kept out of two ranks.
+
+def _forked(d):
+    """Slot 0 keeps a 300-token point and a longer chain past it: a prompt sharing only the point forks a copy."""
+
+    prefix, snap = [7] * 300, {"pos": 300, "mtp_len": 299}
+    d.slots[0].pos, d.slots[0].mtp_len, d.slots[0].capacity = 302, 301, 1024
+    d.kept = [(prefix, d.slots[0], snap, "tail"), (prefix + [4, 5], d.slots[0], {"pos": 302}, "later")]
+    d.free = [d.slots[1], d.slots[2]]
+    return prefix, snap
+
+
+def test_a_prefix_fork_is_planned_as_a_copy_and_resumes_from_its_source_on_both_ranks():
+    leader, follower = decoder(), decoder()
+    prefix, _ = _forked(leader)
+    _, snap = _forked(follower)
+    request = Stream(prefix + [6, 7, 8], 8)
+    plan = admission(leader, request)
+    assert plan["actions"] == [["resize", 2, 1024], ["copy_prefix", 2, 0, 300, 299]]
+    assert (plan["slot"], plan["cached"], plan["source"]) == (2, 300, 0)
+    assert plan["free"] == [1] and plan["kept"] == [[0, 300], [0, 302]]       # the source keeps its chain
+    assert not any(st.operations for st in leader.slots) and len(leader.free) == 2
+    follower.w.comm = None                               # no collective is needed to replay the plan
+    slot, resume, cached = follower._prepare_admission(Stream(prefix + [6, 7, 8], 8), plan)
+    assert slot is follower.slots[2] and cached == 300 and resume == {"state": snap, "tail": "tail"}
+    assert follower.slots[2].operations == [("resize", 1024), ("copy_prefix", follower.slots[0], 300, 299)]
+    assert follower.free == [follower.slots[1]] and [len(k[0]) for k in follower.kept] == [300, 302]
+
