+def test_the_lone_graph_slot_keeps_its_rows_and_graphs_across_lone_requests():
+    """Without kept prompt ends (``keep=0``) the idle graph slot goes back to the free list at the rows it grew to:
+    the graphs warmed at startup serve a first lone request, a next lone request and a smaller stream moving in
+    replay the graphs captured after growth, all with serial decoding's tokens."""
+
+    from test_flashnext_forward import _model
+
+    w = _model()
+    dec = MultiDecoder(w, slots=3, capacity=1024, depth=3, prefill_rows=64, lone_graphs=True)
+    dec.keep = 0
+    sampling = Sampling(seed=31, top_k=20, top_p=0.95)
+
+    def serve(*streams):
+        for s in streams:
+            dec.admit(s)
+        while dec.live():
+            dec.finish(dec.round())
+
+    dec.warm()
+    slot, warmed = dec.solo.st, dec.solo.graphs
+    assert warmed.captures > 0 and slot.pos == 0
+    small = Stream(PROMPTS[0], 12, sampling)
+    serve(small)
+    assert small.st is slot and dec.solo.graphs is warmed       # no resize: the startup graphs replay
+    long = (PROMPTS[1] * 47)[:270]
+    first = Stream(long, 12, sampling)
+    serve(first)
+    graphs = dec.solo.graphs                                     # grown to 1024 rows: captured again once
+    assert first.st is slot and slot.capacity == 1024 and any(f is slot for f in dec.free)
+    second = Stream(PROMPTS[3], 12, sampling)
+    serve(second)
+    assert second.st is slot and dec.solo.graphs is graphs
+    a, b = Stream(long, 3, sampling), Stream(PROMPTS[0], 16, sampling)      # b outlives a, then moves into the slot
+    serve(a, b)
+    assert a.st is slot and b.st is slot and dec.solo.graphs is graphs and slot.capacity == 1024
+    for s in (small, first, second, a, b):
+        e = Engine(w, capacity=1024, max_rows=8, prefill_rows=64)
+        assert s.out == serial_decode(e, prefill(e, s.prompt, sampling), s.count, sampling).tokens
