+# The lone-graph slot keeps its rows, and so its captured graphs, across lone requests until memory is needed.
+
+class Graphs:
+    def __init__(self, e, *, max_rows):
+        self.e = e
+
+
+def _graph_slot_pair(monkeypatch):
+    """Rank 0 and rank 1, slot 0 holding the lone stream's graphs (a new Graphs object is a recapture)."""
+
+    from tensorfold.families.qwen4_exp.cuda import graphs
+
+    monkeypatch.setattr(graphs, "Graphs", Graphs)
+    pair = (decoder(), decoder())
+    for d in pair:
+        d.solo, d.solo_on = SimpleNamespace(st=d.slots[0], rows=4), True
+        d.solo.graphs = Graphs(d.solo, max_rows=4)
+    return pair
+
+
+def _admit_both(leader, follower, prompt):
+    """Rank 0 plans the admission, both ranks check and apply it; the request then decodes on its slot."""
+
+    plan = admission(leader, Stream(prompt, 8))
+    for d in (leader, follower):
+        assert ready(d, plan)
+        apply(d, plan)
+        d.streams[d.next_id] = Stream(prompt, 8, sid=d.next_id, st=d.slots[plan["slot"]], out=[3], drafts=[4])
+        d.next_id += 1
+    return plan
+
+
+def _round_both(leader, follower):
+    plan = round_plan(leader)
+    for d in (leader, follower):
+        assert ready(d, plan)
+        apply(d, plan)
+    return plan
+
+
+def test_an_idle_lone_graph_slot_keeps_its_rows_and_graphs_across_lone_requests(monkeypatch):
+    from tensorfold.families.qwen4_exp.cuda.multi_tp import shape
+
+    leader, follower = _graph_slot_pair(monkeypatch)
+    first = _admit_both(leader, follower, [7] * 310)
+    assert first["slot"] == 0 and first["actions"] == [["resize", 0, 1024, "alone"]]
+    graphs = [d.solo.graphs for d in (leader, follower)]          # captured at this geometry from here on
+    assert _round_both(leader, follower)["solo"] == 0
+    for d in (leader, follower):                         # both ranks finish the same stream (rank 0's "finish")
+        d.finish(list(d.streams.values()))
+        assert d.slots[0].capacity == 1024 and d.free[-1] is d.slots[0]
+    assert shape(leader) == shape(follower)
+    second = _admit_both(leader, follower, [8] * 300)
+    assert second["slot"] == 0 and second["actions"] == []        # no resize: nothing to recapture
+    assert _round_both(leader, follower)["solo"] == 1
+    for d, g in zip((leader, follower), graphs):
+        assert d.solo.graphs is g and d.slots[0].operations == [("resize", 1024), ("reset",)]
+        assert d.memory_gate.held == 2 * (1024 - 256) * 100       # the slot's rows above its first, counted once
+    assert shape(leader) == shape(follower)
+
